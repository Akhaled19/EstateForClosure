APP_ENV=development
SECRET_KEY=

#Postgres (Supabase) - use the Transaction Pooler URI from
#Project Settings > Database, with +asyncpg added to the scheme
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-1-us-east-1.pooler.supabase.com:6543/postgres
#MongoDB (Atlas)
MONGO_URI=mongodb+srv://your-db-user:your-password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB=estate_db

REDIS_URL=redis://redis:6379

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

#Anthropic API 
ANTHROPIC_API_KEY = 